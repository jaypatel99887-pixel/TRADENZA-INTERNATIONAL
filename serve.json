{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/static/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/requirements", "destination": "/api/requirements.json" }
  ]
}
